      <string>QWidget#GestionProductos { background-color:#101414; color:#f4f7f5; font-family:"Segoe UI"; font-size:13px; }
QLabel { background:transparent; color:#f4f7f5; }
QFrame#framePrincipal, QFrame#frameProductos, QFrame#frameDatosProducto { background-color:#101817; border:2px solid #28e77a; border-radius:17px; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background-color:#202a26; color:white; border:2px solid #28e77a; border-radius:9px; padding:6px; min-height:22px; }
QPushButton { background-color:#07643b; color:white; border:2px solid #28e77a; border-radius:10px; font-weight:bold; padding:8px; }
QPushButton:hover { background-color:#128a51; }
QPushButton#btnDesactivar, QPushButton#btnRegresar { background-color:#6d2d39; border-color:#f0657b; }
QTableWidget { background-color:#101817; alternate-background-color:#192320; color:white; gridline-color:#30473d; border:0px; selection-background-color:#116c42; }
QHeaderView::section { background-color:#075d39; color:white; padding:8px; font-weight:bold; border:0px; }
QTableCornerButton::section { background-color:#075d39; }
</string>
